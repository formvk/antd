{
  "name": "@formvk/antd-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "Formvk Ant Design v6 component bridge monorepo",
  "type": "module",
  "scripts": {
    "build": "pnpm --filter @formvk/antd build",
    "dev": "pnpm --filter @formvk/antd dev",
    "typecheck": "pnpm --filter @formvk/antd typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "version:release": "lerna version",
    "version:alpha": "lerna version --conventional-prerelease --preid alpha",
    "version:beta": "lerna version --conventional-prerelease --preid beta",
    "version:rc": "lerna version --conventional-prerelease --preid rc",
    "version:exit-pre": "lerna version --conventional-graduate",
    "prepare": "husky"
  },
  "devDependencies": {
    "@formvk/core": "~1.1.1",
    "@formvk/react": "~1.1.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "antd": "^6.6.8",
    "dayjs": "^1.11.23",
    "husky": "^9.1.7",
    "lerna": "^10.1.1",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "~6.0.3",
    "vitepress": "^1.6.4",
    "vitepress-demo-plugin": "^1.8.0",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxlint --fix --no-error-on-unmatched-pattern",
      "oxfmt --no-error-on-unmatched-pattern"
    ],
    "*.{json,jsonc,md,mdx,css,less,scss,html,yml,yaml}": "oxfmt --no-error-on-unmatched-pattern"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@12.21.0"
}
