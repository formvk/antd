{
  "name": "@formvk/antd",
  "version": "1.1.0-beta.4",
  "description": "Ant Design v6 component bridge for Formvk",
  "keywords": [
    "antd",
    "bridge",
    "form",
    "formvk",
    "react"
  ],
  "license": "MIT",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc --noEmit && vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src"
  },
  "dependencies": {
    "@ant-design/cssinjs": "~2.1.2",
    "@ant-design/icons": "^6.3.4",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@formvk/core": "catalog:",
    "@formvk/models": "catalog:",
    "@formvk/react": "catalog:",
    "@formvk/reactive": "catalog:",
    "@formvk/reactive-react": "catalog:",
    "@formvk/schema": "catalog:",
    "@formvk/shared": "catalog:",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.23",
    "react-sticky-box": "^2.0.5"
  },
  "peerDependencies": {
    "antd": "^6.0.0",
    "react": ">=18",
    "react-dom": ">=18"
  }
}
